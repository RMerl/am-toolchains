prefix=/auto/toolbuild/bintools//crosstools-arm_hf-gcc-13.2-linux-5.15-glibc-2.38-binutils-2.41
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: expat
Version: 2.6.2
Description: expat XML parser
URL: https://libexpat.github.io/
Libs: -L${libdir} -lexpat
Libs.private: -lm
Cflags: -I${includedir}
Cflags.private: -DXML_STATIC
