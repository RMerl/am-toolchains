# See: man pkg-config
prefix=/auto/toolbuild/bintools//crosstools-arm_hf-gcc-13.2-linux-5.15-glibc-2.38-binutils-2.41
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Python
Description: Build a C extension for Python
Requires:
Version: 3.11
Libs.private: -lpthread -ldl  -lutil
Libs:
Cflags: -I${includedir}/python3.11
